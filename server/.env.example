PORT=3000

# false (padrão): só aceita leituras reais do Arduino. true: gera leituras simuladas (demonstração).
SIMULATE=false
SIMULATOR_INTERVAL_MS=30000

# Se definida, o Arduino precisa enviar o header x-api-key com este valor.
INGEST_API_KEY=

# IA generativa local (opcional, grátis e sem limite). Instale o Ollama (https://ollama.com), rode
#   ollama pull qwen2.5:3b
# e preencha abaixo. Sem isso, o chat responde por regras (instantâneo) direto do banco.
# Modelos menores = respostas mais rápidas (qwen2.5:1.5b); maiores = mais inteligentes (qwen2.5:7b).
# Dica: defina OLLAMA_KEEP_ALIVE=24h no Windows para o modelo não descarregar da memória.
# O que a IA enxerga (sensores, histórico, observações, prompt) se edita em server/ai.config.json, sem reiniciar.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=
