{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:prod": "vite build && vite preview",
    "server": "npm --prefix server run start",
    "server:install": "npm --prefix server install",
    "dev:full": "concurrently -k -n api,web -c cyan,magenta \"npm run server\" \"vite --mode backend\"",
    "start:full": "vite build --mode backend && concurrently -k -n api,web -c cyan,magenta \"npm run server\" \"vite preview\""
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87",
    "framer-motion": "^14.7.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0",
    "usehooks-ts": "^3.1.1",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
